<svg width="800" height="400" viewBox="0 0 800 400" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-labelledby="descId-{{ username }}">
  <title id="titleId-{{ username }}">Estatísticas de GitHub de {{ name }}</title>
  <desc id="descId-{{ username }}">Cartão de estatísticas estilo RPG para o usuário {{ username }}. Nível {{ (total_contributions // 100) + 1 }} Artificer, com {{ total_contributions }} XP total, {{ total_commits }} commits, {{ total_prs }} pull requests e {{ total_issues }} issues.</desc>

  <style>
    /* --- Typography & Base --- */
    .text-base { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; fill: #c9d1d9; }
    .text-title { font-weight: 600; font-size: 24px; fill: #ffffff; }
    .text-subtitle { font-weight: 400; font-size: 14px; fill: #8b949e; }
    .text-stat-value { font-weight: 700; font-size: 28px; fill: #58a6ff; }
    .text-stat-label { font-weight: 600; font-size: 12px; fill: #8b949e; text-transform: uppercase; letter-spacing: 1px; }
    .text-lang-name { font-weight: 600; font-size: 14px; fill: #c9d1d9; }
    .text-lang-percent { font-weight: 400; font-size: 12px; fill: #8b949e; }

    /* --- Animations --- */
    @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
    @keyframes slideUp { from { transform: translateY(10px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
    /* PERFORMANCE: Usando scaleX ao invés de width para evitar reflow */
    @keyframes fillBar { from { transform: scaleX(0); } to { transform: scaleX(1); } }

    .animate-fade-in { animation: fadeIn 0.8s ease-out forwards; }
    .animate-slide-up { animation: slideUp 0.8s ease-out forwards; opacity: 0; }

    .delay-1 { animation-delay: 0.2s; }
    .delay-2 { animation-delay: 0.4s; }
    .delay-3 { animation-delay: 0.6s; }

    /* --- Components --- */
    .card-bg { fill: #0d1117; rx: 10px; }
    .card-border { stroke: #30363d; stroke-width: 1; rx: 10px; fill: none; }

    .stat-box { fill: #161b22; rx: 6px; }
    .stat-box-border { stroke: #30363d; stroke-width: 1; rx: 6px; fill: none; }

    .progress-bg { fill: #21262d; rx: 4px; }
    .progress-bar {
        rx: 4px;
        transform-origin: left; /* Necessário para scaleX funcionar corretamente */
        animation: fillBar 1s ease-out forwards;
    }
  </style>

  <!-- Background -->
  <rect width="800" height="400" class="card-bg" />

  <!-- Grid Pattern com ID ÚNICO para evitar colisão -->
  <defs>
    <pattern id="grid-{{ username }}" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#21262d" stroke-width="1" opacity="0.3"/>
    </pattern>
    <clipPath id="avatar-clip-{{ username }}">
        <circle cx="40" cy="40" r="40" />
    </clipPath>
  </defs>

  <rect width="800" height="400" fill="url(#grid-{{ username }})" rx="10" />
  <rect width="800" height="400" class="card-border" />

  <!-- Conteúdo Principal -->
  <g transform="translate(40, 40)" class="animate-fade-in">
    <!-- Fallback & Avatar -->
    <circle cx="40" cy="40" r="42" fill="#30363d" />
    <g clip-path="url(#avatar-clip-{{ username }})" role="presentation">
      <rect x="0" y="0" width="80" height="80" fill="#21262d" />
      <circle cx="40" cy="30" r="14" fill="#8b949e" />
      <path d="M12 78 C16 58, 28 50, 40 50 C52 50, 64 58, 68 78 Z" fill="#8b949e" />
    </g>

    <!-- Meta info -->
    <text x="100" y="35" class="text-base text-title">{{ name }}</text>
    <text x="100" y="60" class="text-base text-subtitle">@{{ username }} • Level {{ (total_contributions // 100) + 1 }} Artificer</text>
  </g>

  <!-- Stats Row -->
  <g transform="translate(40, 150)" class="animate-slide-up delay-1">
    <!-- Stat 1: Contributions (XP) -->
    <g transform="translate(0, 0)">
      <rect width="160" height="80" class="stat-box" />
      <rect width="160" height="80" class="stat-box-border" />
      <text x="20" y="30" class="text-base text-stat-label">Total XP</text>
      <text x="20" y="60" class="text-base text-stat-value">{{ total_contributions }}</text>
    </g>

    <!-- Stat 2: Commits (STR) -->
    <g transform="translate(180, 0)">
      <rect width="160" height="80" class="stat-box" />
      <rect width="160" height="80" class="stat-box-border" />
      <text x="20" y="30" class="text-base text-stat-label">Commits</text>
      <text x="20" y="60" class="text-base text-stat-value" fill="#79c0ff">{{ total_commits }}</text>
    </g>

    <!-- Stat 3: PRs (DEX) -->
    <g transform="translate(360, 0)">
      <rect width="160" height="80" class="stat-box" />
      <rect width="160" height="80" class="stat-box-border" />
      <text x="20" y="30" class="text-base text-stat-label">Pull Req.</text>
      <text x="20" y="60" class="text-base text-stat-value" fill="#d2a8ff">{{ total_prs }}</text>
    </g>

    <!-- Stat 4: Issues (INT) -->
    <g transform="translate(540, 0)">
      <rect width="160" height="80" class="stat-box" />
      <rect width="160" height="80" class="stat-box-border" />
      <text x="20" y="30" class="text-base text-stat-label">Issues</text>
      <text x="20" y="60" class="text-base text-stat-value" fill="#ff7b72">{{ total_issues }}</text>
    </g>
  </g>

  <!-- Languages Section -->
  <g transform="translate(40, 260)" class="animate-slide-up delay-2">
    <text x="0" y="0" class="text-base text-stat-label" style="font-size: 14px; fill: #ffffff;">Top Masteries</text>

    {% for lang in top_languages %}
    <g transform="translate(0, {{ loop.index0 * 28 + 20 }})">
      <text x="0" y="10" class="text-base text-lang-name">{{ lang.name }}</text>
      <rect x="120" y="2" width="500" height="8" class="progress-bg" />

      <!-- PERFORMANCE: Largura controlada via style inline no elemento para ser o "alvo" do scaleX -->
      <!-- O scaleX vai de 0 a 1 na animação, então a largura base deve ser a largura final desejada -->
      <rect x="120" y="2" width="{{ lang.percentage * 5 }}" height="8" fill="{{ lang.color }}" class="progress-bar" />

      <text x="640" y="10" class="text-base text-lang-percent">{{ "%.1f"|format(lang.percentage) }}%</text>
    </g>
    {% endfor %}
  </g>

  <g transform="translate(780, 380)" class="animate-fade-in delay-3">
    <text text-anchor="end" class="text-base text-subtitle" style="font-size: 10px;">Generated by Antigravity</text>
  </g>
</svg>
